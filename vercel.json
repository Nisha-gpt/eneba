{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "go",
      "entrypoint": "main.go"
    },
    "web": {
      "root": "web",
      "framework": "vite",
      "outputDirectory": "dist",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/(assets|art)(/.*)?", "status": 404 },
        { "src": "/.*", "dest": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
